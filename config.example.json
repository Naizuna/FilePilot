{
  "source_folder": "~/Downloads",
  "categories": {
    "Images": {
      "extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".heic"],
      "destination": "~/Pictures/Sorted"
    },
    "Documents": {
      "extensions": [".pdf", ".docx", ".doc", ".txt", ".md", ".rtf", ".odt"],
      "destination": "~/Documents/Sorted"
    },
    "Spreadsheets": {
      "extensions": [".xlsx", ".xls", ".csv", ".ods"],
      "destination": "~/Documents/Spreadsheets"
    },
    "Videos": {
      "extensions": [".mp4", ".mov", ".avi", ".mkv", ".webm", ".flv"],
      "destination": "~/Videos/Sorted"
    },
    "Audio": {
      "extensions": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a"],
      "destination": "~/Music/Sorted"
    },
    "Archives": {
      "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2"],
      "destination": "~/Documents/Archives"
    },
    "Code": {
      "extensions": [".py", ".js", ".ts", ".html", ".css", ".json", ".xml", ".yaml", ".yml", ".sh", ".bat", ".ps1"],
      "destination": "~/Documents/Code"
    },
    "Executables": {
      "extensions": [".exe", ".msi", ".dmg", ".app", ".apk"],
      "destination": "~/Documents/Installers"
    },
    "Finance": {
      "extensions": [],
      "destination": "~/Documents/Finance"
    }
  },
  "keyword_rules": {
    "invoice": "Finance",
    "receipt": "Finance",
    "bill": "Finance",
    "statement": "Finance",
    "lecture": "Documents",
    "homework": "Documents",
    "assignment": "Documents",
    "screenshot": "Images",
    "photo": "Images",
    "video": "Videos",
    "music": "Audio",
    "song": "Audio"
  },
  "ai_categorization": {
    "enabled": false,
    "provider": "local",
    "model": "llama3.2:3b",
    "api_key_env": "OPENAI_API_KEY",
    "allowed_extensions": [".txt", ".md", ".pdf", ".docx"],
    "max_file_size_kb": 50,
    "max_chars": 5000
  },
  "skip_extensions": [".crdownload", ".part", ".tmp", ".download"],
  "skip_folders": true
}